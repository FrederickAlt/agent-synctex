[Unit]
Description=pdf-preview Host Service
Documentation=https://github.com/FrederickAlt/agent-synctex
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/projects/AI/pi_extensions/pdf-preview
ExecStart=/usr/bin/env sh -c 'DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=%t/bus}" exec /usr/bin/node %h/projects/AI/pi_extensions/pdf-preview/scripts/agent-synctex-host-service.ts start'
Restart=on-failure
RestartSec=2
Environment=NODE_NO_WARNINGS=1
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
