[Unit]
Description=tex-actions Host Service
Documentation=https://github.com/FrederickAlt/agent-synctex
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory={{REPO_ROOT}}
ExecStart=/usr/bin/env sh -c 'DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=%t/bus}" exec {{NODE_PATH}} {{SCRIPT_PATH}} daemon --socket {{SOCKET_PATH}}'
Restart=on-failure
RestartSec=2
Environment=NODE_NO_WARNINGS=1
Environment=MCP_TMPDIR=%t/tex-actions
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
