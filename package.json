{
  "name": "pdf-preview",
  "version": "0.1.0",
  "description": "stdio MCP server for LaTeX compile actions with browser PDF.js viewing",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --test-reporter=./scripts/fail-only-test-reporter.ts \"test/**/*.test.ts\"",
    "test:verbose": "node --test \"test/**/*.test.ts\"",
    "test:real-tex-smoke": "AGENT_SYNCTEX_REAL_TEX_SMOKE=1 node --test test/modules/host_service_real_latexmk_smoke.test.ts",
    "verify": "npm run check && npm test",
    "tex-actions:mcp": "node scripts/tex-actions-mcp.ts",
    "pdf-preview-mcp": "node scripts/pdf-preview-mcp.ts"
  },
  "bin": {
    "tex-actions-mcp": "scripts/tex-actions-mcp.ts"
  },
  "keywords": [
    "mcp",
    "tex-actions",
    "latex",
    "pdfjs"
  ],
  "dependencies": {
    "@mariozechner/pi-tui": "^0.73.1",
    "pdfjs-dist": "^6.0.227",
    "typebox": "^1.1.39"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^6.0.3"
  }
}
