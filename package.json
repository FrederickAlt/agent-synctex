{
  "name": "agent-synctex",
  "version": "0.1.0",
  "description": "Agent SyncTeX stdio MCP server and harness hook installer for LaTeX PDF workflows with a Viewer Host boundary",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrederickAlt/agent-synctex.git"
  },
  "homepage": "https://github.com/FrederickAlt/agent-synctex#readme",
  "bugs": {
    "url": "https://github.com/FrederickAlt/agent-synctex/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE*",
    "package.json"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build-package.ts",
    "check": "tsc --noEmit",
    "test": "node --test --test-reporter=./scripts/fail-only-test-reporter.ts \"test/**/*.test.ts\"",
    "debug:forward-synctex": "node scripts/debug-forward-synctex.ts",
    "test:verbose": "node --test \"test/**/*.test.ts\"",
    "smoke:stdio-viewer": "node --test --test-reporter=spec --test-name-pattern=\"routes open_pdf to the Viewer Host boundary without owning PDF serving\" test/modules/stdio_mcp_runtime.test.ts",
    "verify": "npm run check && npm test",
    "release:check": "npm run verify && npm pack --dry-run",
    "prepublishOnly": "npm run verify",
    "prepack": "npm run build",
    "viewer-host": "node scripts/viewer-host-server.ts"
  },
  "bin": {
    "agent-synctex": "dist/scripts/agent-synctex.js"
  },
  "keywords": [
    "mcp",
    "tex-actions",
    "latex",
    "viewer-host"
  ],
  "dependencies": {
    "iconv-lite": "^0.7.2",
    "pdfjs-dist": "^6.0.227"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3"
  }
}
