{
  "name": "pdf-preview",
  "version": "0.1.0",
  "description": "Pi extension providing LaTeX preview and local file compile tools",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test \"*.test.ts\" \"test/**/*.test.ts\"",
    "verify": "npm run check && npm test",
    "host-service:start": "node scripts/tex-actionsctl.ts start",
    "host-service:status": "node scripts/tex-actionsctl.ts status",
    "tex-actionsctl": "node scripts/tex-actionsctl.ts"
  },
  "keywords": [
    "pi-extension",
    "pdf",
    "latex",
    "show-latex"
  ],
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@mariozechner/pi-tui": "^0.73.1",
    "typebox": "^1.1.39"
  }
}
